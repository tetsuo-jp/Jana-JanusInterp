struct Pair {
    int left;
    int right;
};

void classify(Pair pairs[2], int total) {
    local int lefts[2] = { 0, 0 } {
        lefts[0] += pairs[0].left;
        lefts[1] += pairs[1].left;
        for (int i = 0; i < 2; i += 1) {
            total += lefts[i];
        }
    } delocal int lefts[2] = { 0, 0 };

    for (int i = 0; i < 1; i += 1) {
        local int code = 0 {
            code += pairs[i].left + pairs[i].right;
            switch (code) {
                case 0:
                    total += 1;
                    break;
                default:
                    total += (code == 2 ? 2 : 3);
                    break;
            } switch (code);
        } delocal int code = 0;
    }
}

void main() {
    Pair pairs[2];
    int total;
    pairs[0].left += 1;
    pairs[0].right += 1;
    pairs[1].left += 2;
    pairs[1].right += 1;
    call classify(pairs, total);
    printf("%d\n", total);
}

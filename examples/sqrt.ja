/*
 * Calculating the square root of an integer.
 * Adapted version of example from "Janus: a time-reversible language" by
 * C. Lutz and H. Derby.
 */

void doublebit(int bit) {
    local int z = bit
        bit += z;
    delocal int z = bit / 2;
}

// Calculates floor(sqrt(num))
void root(int num, int root) {
    local int bit = 1
        from (bit == 1) {
            call doublebit(bit);
        } loop {
        } until ((bit * bit) > num);

        from ((bit * bit) > num) {
            uncall doublebit(bit);
            if (((root + bit) * (root + bit)) <= num) {
                root += bit;
            } fi ((root / bit) % 2 != 0);
        } loop {
        } until (bit == 1);
    delocal int bit = 1;
    num -= root * root;
}

void main() {
    int num, root;

    num += 66;
    printf("%d %d \n", num, root);
    call root(num, root);
    printf("%d %d \n", num, root);
    /*
    root += 25
    uncall root(num, root)
    */
}

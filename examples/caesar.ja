// Reversible Caesar cipher.
// Demonstrates: #define, char arrays, call/uncall reversibility.
// Encrypt with `call caesar`, decrypt with `uncall caesar`.

#define LEN 12

void caesar(char buf[LEN], int key) {
    for (int i = 0; i < LEN - 2; i += 1) {
        local int ch = buf[i] {
            if (ch >= 97 && ch <= 122) {
                buf[i] -= ch;
                buf[i] += (ch - 97 + key) % 26 + 97;
            }
            fi (buf[i] >= 97 && buf[i] <= 122);
        }
        delocal int ch = (buf[i] >= 97 && buf[i] <= 122 ? (buf[i] - 97 - key + 26) % 26 + 97 : buf[i]);
    }
}

void main() {
    char plain[LEN] = "hello world";
    char cipher[LEN] = "hello world";
    char back[LEN] = "hello world";
    int key = 3;
    call caesar(cipher, key);
    call caesar(back, key);
    uncall caesar(back, key);
    printf("plain:  %s\n", plain);
    printf("cipher: %s\n", cipher);
    printf("back:   %s\n", back);
}

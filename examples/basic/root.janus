// Calculating a square root of an integer

// C. Lutz and H. Derby.
// Janus: a time-reversible language. A letter to Landauer.
// 1982.

void doublebit(int bit) {
    local int z = 0 {
        z += bit;
        bit += z;
    }
    delocal int z = bit / 2;
}

void root(int num, int root) {
    local int bit = 0 {
        bit += 1;
        from (bit == 1) {
        }
        loop {
            call doublebit(bit);
        }
        until ((bit * bit) > num);

        from ((bit * bit) > num) {
            uncall doublebit(bit);
            if (((root + bit) * (root + bit)) <= num) {
                root += bit;
            }
            fi (((root / bit) % 2) != 0);
        }
        loop {
        }
        until (bit == 1);
    }
    delocal int bit = 1;
    num -= root * root;
}

void main() {
    int num;
    int root_val;

    num += 100;
    call root(num, root_val);
    printf("%d %d\n", num, root_val);
}

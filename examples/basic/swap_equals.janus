// David Gries: The science of programming, 1987
// pp.268

void swap_equals(int k, int n, int i, int j, int b[20]) {
    from (k == 0) {
    }
    loop {
        b[i + k] <=> b[j + k];
        k += 1;
    }
    until (k == n);
}

void main() {
    int k;
    int n;
    int i;
    int j;
    int b[20];

    from (i == 0) {
    }
    loop {
        b[i] ^= i;
        i += 1;
    }
    until (i == 20);
    i -= 20;
    i += 5;
    j += 15;
    n += 3;
    call swap_equals(k, n, i, j, b);
    show(b);
}

// C. Lutz and H. Derby.
// Janus: a time-reversible language. A letter to Landauer.
// 1982.

// Bubble sort with permutation tracking.

void sort(int list[12], int perm[12], int n, int i, int j) {
    from (i == 0) {
    }
    loop {
        j += n - 2;
        from (j == n - 2) {
        }
        loop {
            if (list[j] > list[j + 1]) {
                list[j] <=> list[j + 1];
                perm[j] <=> perm[j + 1];
            }
            fi (perm[j] > perm[j + 1]);
            j -= 1;
        }
        until (j == i - 1);
        j -= i - 1;
        i += 1;
    }
    until (i == n - 1);
    i -= n - 1;
}

void makeidperm(int perm[12], int n, int i) {
    from (i == 0) {
    }
    loop {
        perm[i] += i;
        i += 1;
    }
    until (i == n);
    i -= n;
}

void main() {
    int list[12];
    int perm[12];
    int n;
    int i;
    int j;

    n += 4;
    list[0] += 2;
    list[1] += 3;
    list[2] += 1;
    list[3] += 0;
    call makeidperm(perm, n, i);
    call sort(list, perm, n, i, j);
    show(list);
    show(perm);
}

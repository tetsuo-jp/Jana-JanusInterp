; Fibonacci numbers in original 1982 Janus syntax (Lutz & Derby)
; Global variables (all initialized to zero)
n       ;Input: which Fibonacci number to compute
x1      ;Output: fib(n)
x2      ;Output: fib(n+1)

procedure fib
    if n = 0
    then x1 += 1
         x2 += 1
    else n -= 1
         call fib
         x1 += x2
         x1 : x2
    fi x1 = x2

procedure main
    n += 10
    call fib
    write x1
    write x2

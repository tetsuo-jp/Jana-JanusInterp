; Integer square root in original 1982 Janus syntax (Lutz & Derby)
; Computes root = floor(sqrt(num)), leaves num -= root*root

num root   z bit

procedure root              ;root := floor (sqrt(num))
    bit += 1
    from bit=1              ;find exponential ball park
    loop call doublebit
    until (bit*bit) > num
    from (bit*bit) > num
    do   uncall doublebit
         if   ((root+bit)*(root+bit)) <= num
         then root += bit
         fi   ((root/bit)\2) # 0
    until bit=1
    bit -= 1
    num -= root*root

procedure doublebit
    z += bit
    bit += z
    z -= bit/2

procedure main
    num += 144
    call root
    write root   ; should print 12
    write num    ; should print 0  (144 - 12*12 = 0)

// C-style Modern Janus Self-Interpreter
// Uses: struct with ;, semicolons after ALL statements, braces, void, MULTI-ANCILLA, and SWITCH.

#include "opcodes.ja"

struct VM {
    int code[4096];
    int store[1024];
    int procs[256];  // [offset, n_stmts, n_params, 0] * 64 procs
    int pc;
    int n;
};

#define GET_CODE(off) vm.code[off]
#define GET_STORE(idx) vm.store[idx]

// ── Expression evaluation ────────────────────────────────────────────

void eval_expr(VM vm, int pc, int result) {
    switch (GET_CODE(pc)) {
        case E_CONST:  result += GET_CODE(pc + 2);
            break;
        case E_VAR:    result += GET_STORE(GET_CODE(pc + 2));
            break;
        case E_BINOP:  call eval_binop(vm, pc, result);
            break;
        case E_ARRIDX: call eval_arridx(vm, pc, result);
            break;
    } 
}

void eval_binop(VM vm, int pc, int result) {
    ancilla (int op = GET_CODE(pc + 2),
             int lpc = pc + 3,
             int lv = 0) {
        call eval_expr(vm, lpc, lv);
        ancilla (int rpc = lpc + GET_CODE(lpc + 1),
                 int rv = 0) {
            call eval_expr(vm, rpc, rv);
            call apply_binop(op, lv, rv, result);
            uncall eval_expr(vm, rpc, rv);
        };
        uncall eval_expr(vm, lpc, lv);
    };
}

void apply_binop(int op, int a, int b, int result) {
    switch (op) {
        case OP_ADD:  result += a + b;
            break;
        case OP_SUB:  result += a - b;
            break;
        case OP_MUL:  result += a * b;
            break;
        case OP_DIV:  result += a / b;
            break;
        case OP_MOD:  result += a % b;
            break;
        case OP_AND:  result += a & b;
            break;
        case OP_OR:   result += a | b;
            break;
        case OP_XOR:  result += a ^ b;
            break;
        case OP_LT:   result += (a < b ? 1 : 0);
            break;
        case OP_GT:   result += (a > b ? 1 : 0);
            break;
        case OP_EQ:   result += (a == b ? 1 : 0);
            break;
        case OP_NEQ:  result += (a != b ? 1 : 0);
            break;
        case OP_LE:   result += (a <= b ? 1 : 0);
            break;
        case OP_GE:   result += (a >= b ? 1 : 0);
            break;
        case OP_LAND: result += (a != 0 && b != 0 ? 1 : 0);
            break;
        case OP_LOR:  result += (a != 0 || b != 0 ? 1 : 0);
            break;
    } switch (op);
}

void eval_arridx(VM vm, int pc, int result) {
    ancilla (int base = GET_CODE(pc + 2),
             int ipc = pc + 3,
             int idx = 0) {
        call eval_expr(vm, ipc, idx);
        result += GET_STORE(base + idx);
        uncall eval_expr(vm, ipc, idx);
    };
}

// ── Lvalue resolution ────────────────────────────────────────────────

void resolve_lval(VM vm, int pc, int slot) {
    switch (GET_CODE(pc)) {
        case L_VAR:    slot += GET_CODE(pc + 2);
            break;
        case L_ARRIDX:
            ancilla (int base = GET_CODE(pc + 2),
                     int ipc = pc + 3,
                     int idx = 0) {
                call eval_expr(vm, ipc, idx);
                slot += base + idx;
                uncall eval_expr(vm, ipc, idx);
            };
            break;
    } switch (GET_CODE(pc));
}

// ── Statement execution ──────────────────────────────────────────────

void exec_stmts(VM vm) {
    if (vm.n != 0) {
        call dispatch(vm);
        ancilla (int slen = GET_CODE(vm.pc + 1)) {
            vm.pc += slen;
            vm.n -= 1;
            call exec_stmts(vm);
            vm.n += 1;
            vm.pc -= slen;
        };
    } fi (vm.n != 0);
}

void dispatch(VM vm) {
    ancilla (int tag = GET_CODE(vm.pc)) {
        switch (tag) {
            case S_ADDEQ:  call exec_assign(vm, tag);
                break;
            case S_SUBEQ:  call exec_assign(vm, tag);
                break;
            case S_XOREQ:  call exec_assign(vm, tag);
                break;
            case S_SWAP:   call exec_swap(vm);
                break;
            case S_IF:     call exec_if(vm);
                break;
            case S_FROM:   call exec_from(vm);
                break;
            case S_CALL:   call exec_call_stmt(vm);
                break;
            case S_UNCALL: call exec_uncall_stmt(vm);
                break;
            case S_SKIP:   skip;
                break;
        } switch (tag);
    };
}

void exec_assign(VM vm, int tag) {
    ancilla (int lpc = vm.pc + 2,
             int slot = 0) {
        call resolve_lval(vm, lpc, slot);
        ancilla (int epc = lpc + GET_CODE(lpc + 1),
                 int val = 0) {
            call eval_expr(vm, epc, val);
            switch (tag) {
                case S_ADDEQ: GET_STORE(slot) += val;
                    break;
                case S_SUBEQ: GET_STORE(slot) -= val;
                    break;
                case S_XOREQ: GET_STORE(slot) ^= val;
                    break;
            } switch (tag);
            uncall eval_expr(vm, epc, val);
        };
        uncall resolve_lval(vm, lpc, slot);
    };
}

void exec_swap(VM vm) {
    ancilla (int l1pc = vm.pc + 2,
             int s1 = 0) {
        call resolve_lval(vm, l1pc, s1);
        ancilla (int l2pc = l1pc + GET_CODE(l1pc + 1),
                 int s2 = 0) {
            call resolve_lval(vm, l2pc, s2);
            GET_STORE(s1) <=> GET_STORE(s2);
            uncall resolve_lval(vm, l2pc, s2);
        };
        uncall resolve_lval(vm, l1pc, s1);
    };
}

void exec_if(VM vm) {
    ancilla (int cpc = vm.pc + 2,
             int go = 0,
             int cv = 0) {
        call eval_expr(vm, cpc, cv);
        if (cv != 0) { go += 1; } fi (go != 0);
        uncall eval_expr(vm, cpc, cv);
        
        if (go == 1) {
            ancilla (int tc = GET_CODE(cpc + GET_CODE(cpc + 1)),
                     int tpc = cpc + GET_CODE(cpc + 1) + 2,
                     int saved_pc = 0,
                     int saved_n = 0) {
                saved_pc += vm.pc;
                saved_n += vm.n;
                vm.pc -= saved_pc;
                vm.n -= saved_n;
                vm.pc += tpc;
                vm.n += tc;
                call exec_stmts(vm);
                vm.n -= tc;
                vm.pc -= tpc;
                vm.n += saved_n;
                vm.pc += saved_pc;
                saved_n -= vm.n;
                saved_pc -= vm.pc;
            };
        } else {
            ancilla (int clen = GET_CODE(cpc + 1),
                     int tblen = GET_CODE(cpc + clen + 1),
                     int ec = GET_CODE(cpc + clen + tblen + 2),
                     int epc = cpc + clen + tblen + 4,
                     int saved_pc = 0,
                     int saved_n = 0) {
                saved_pc += vm.pc;
                saved_n += vm.n;
                vm.pc -= saved_pc;
                vm.n -= saved_n;
                vm.pc += epc;
                vm.n += ec;
                call exec_stmts(vm);
                vm.n -= ec;
                vm.pc -= epc;
                vm.n += saved_n;
                vm.pc += saved_pc;
                saved_n -= vm.n;
                saved_pc -= vm.pc;
            };
        } fi (go == 1);
        
        ancilla (int xpc = cpc + GET_CODE(cpc + 1) + GET_CODE(cpc + GET_CODE(cpc + 1) + 1) + GET_CODE(cpc + GET_CODE(cpc + 1) + GET_CODE(cpc + GET_CODE(cpc + 1) + 1) + 3) + 4,
                 int ev = 0) {
            call eval_expr(vm, xpc, ev);
            if (ev != 0) { go -= 1; } fi (ev != 0);
            uncall eval_expr(vm, xpc, ev);
        };
    };
}

void exec_from(VM vm) {
    ancilla (int gs = GET_CODE(vm.pc + 2),
             int epc = vm.pc + 3,
             int elen = GET_CODE(epc + 1),
             int dc = GET_CODE(epc + elen),
             int dblen = GET_CODE(epc + elen + 1),
             int dpc = epc + elen + 2,
             int lc = GET_CODE(dpc + dblen),
             int lblen = GET_CODE(dpc + dblen + 1),
             int lpc = dpc + dblen + 2,
             int xpc = lpc + lblen) {
        call exec_from_body(vm, dpc, dc, lpc, lc, xpc, gs);
    };
}

void exec_from_body(VM vm, int dpc, int dc, int lpc, int lc, int xpc, int gs) {
    ancilla (int saved_pc = 0,
             int saved_n = 0) {
        saved_pc += vm.pc;
        saved_n += vm.n;
        vm.pc -= saved_pc;
        vm.n -= saved_n;
        vm.pc += dpc;
        vm.n += dc;
        call exec_stmts(vm);
        vm.n -= dc;
        vm.pc -= dpc;
        vm.n += saved_n;
        vm.pc += saved_pc;
        saved_n -= vm.n;
        saved_pc -= vm.pc;
    };
    ancilla (int xf = 0) {
        call eval_expr(vm, xpc, xf);
        if (xf == 0) { GET_STORE(gs) += 1; } fi (GET_STORE(gs) != 0);
        uncall eval_expr(vm, xpc, xf);
    };
    if (GET_STORE(gs) != 0) {
        ancilla (int saved_pc = 0,
                 int saved_n = 0) {
            saved_pc += vm.pc;
            saved_n += vm.n;
            vm.pc -= saved_pc;
            vm.n -= saved_n;
            vm.pc += lpc;
            vm.n += lc;
            call exec_stmts(vm);
            vm.n -= lc;
            vm.pc -= lpc;
            vm.n += saved_n;
            vm.pc += saved_pc;
            saved_n -= vm.n;
            saved_pc -= vm.pc;
        };
        GET_STORE(gs) -= 1;
        call exec_from_body(vm, dpc, dc, lpc, lc, xpc, gs);
        GET_STORE(gs) += 1;
        ancilla (int saved_pc = 0,
                 int saved_n = 0) {
            saved_pc += vm.pc;
            saved_n += vm.n;
            vm.pc -= saved_pc;
            vm.n -= saved_n;
            vm.pc += lpc;
            vm.n += lc;
            uncall exec_stmts(vm);
            vm.n -= lc;
            vm.pc -= lpc;
            vm.n += saved_n;
            vm.pc += saved_pc;
            saved_n -= vm.n;
            saved_pc -= vm.pc;
        };
    } fi (GET_STORE(gs) != 0);
}

void exec_call_stmt(VM vm) {
    ancilla (int pidx = GET_CODE(vm.pc + 2),
             int poff = vm.procs[pidx * 4],
             int pn = vm.procs[pidx * 4 + 1],
             int saved_pc = 0,
             int saved_n = 0) {
        saved_pc += vm.pc;
        saved_n += vm.n;
        vm.pc -= saved_pc;
        vm.n -= saved_n;
        vm.pc += poff;
        vm.n += pn;
        call exec_stmts(vm);
        vm.n -= pn;
        vm.pc -= poff;
        vm.n += saved_n;
        vm.pc += saved_pc;
        saved_n -= vm.n;
        saved_pc -= vm.pc;
    };
}

void exec_uncall_stmt(VM vm) {
    ancilla (int pidx = GET_CODE(vm.pc + 2),
             int poff = vm.procs[pidx * 4],
             int pn = vm.procs[pidx * 4 + 1],
             int saved_pc = 0,
             int saved_n = 0) {
        saved_pc += vm.pc;
        saved_n += vm.n;
        vm.pc -= saved_pc;
        vm.n -= saved_n;
        vm.pc += poff;
        vm.n += pn;
        uncall exec_stmts(vm);
        vm.n -= pn;
        vm.pc -= poff;
        vm.n += saved_n;
        vm.pc += saved_pc;
        saved_n -= vm.n;
        saved_pc -= vm.pc;
    };
}

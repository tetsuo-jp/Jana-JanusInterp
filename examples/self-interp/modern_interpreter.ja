// Modern Janus Self-Interpreter
// Uses Python-Janus features: struct, macros, ternary expressions.

#include "opcodes.ja"

struct VM {
    int code[4096]
    int store[1024]
    int procs[256]  // [offset, n_stmts, n_params, 0] * 64 procs
    int pc
    int n
}

// ── Helpers ─────────────────────────────────────────────────────────

#define GET_CODE(off) vm.code[off]
#define GET_STORE(idx) vm.store[idx]

// ── Expression evaluation ────────────────────────────────────────────

procedure eval_expr(struct VM vm, int pc, int result)
    switch (GET_CODE(pc)) {
        case E_CONST:
            result += GET_CODE(pc + 2);
            break;
        case E_VAR:
            result += GET_STORE(GET_CODE(pc + 2));
            break;
        case E_BINOP:
            call eval_binop(vm, pc, result);
            break;
        case E_ARRIDX:
            call eval_arridx(vm, pc, result);
            break;
    } switch (GET_CODE(pc))

procedure eval_binop(struct VM vm, int pc, int result)
    local int op = GET_CODE(pc + 2)
    local int lpc = pc + 3
    local int lv = 0
        call eval_expr(vm, lpc, lv)
        local int rpc = lpc + GET_CODE(lpc + 1)
        local int rv = 0
            call eval_expr(vm, rpc, rv)
            call apply_binop(op, lv, rv, result)
            uncall eval_expr(vm, rpc, rv)
        delocal int rv = 0
        delocal int rpc = lpc + GET_CODE(lpc + 1)
        uncall eval_expr(vm, lpc, lv)
    delocal int lv = 0
    delocal int lpc = pc + 3
    delocal int op = GET_CODE(pc + 2)

procedure apply_binop(int op, int a, int b, int result)
    switch (op) {
        case OP_ADD:
            result += a + b;
            break;
        case OP_SUB:
            result += a - b;
            break;
        case OP_MUL:
            result += a * b;
            break;
        case OP_DIV:
            result += a / b;
            break;
        case OP_MOD:
            result += a % b;
            break;
        case OP_AND:
            result += a & b;
            break;
        case OP_OR:
            result += a | b;
            break;
        case OP_XOR:
            result += a ^ b;
            break;
        case OP_LT:
            result += (a < b ? 1 : 0);
            break;
        case OP_GT:
            result += (a > b ? 1 : 0);
            break;
        case OP_EQ:
            result += (a = b ? 1 : 0);
            break;
        case OP_NEQ:
            result += (a != b ? 1 : 0);
            break;
        case OP_LE:
            result += (a <= b ? 1 : 0);
            break;
        case OP_GE:
            result += (a >= b ? 1 : 0);
            break;
    } switch (op)

procedure eval_arridx(struct VM vm, int pc, int result)
    local int base = GET_CODE(pc + 2)
    local int ipc = pc + 3
    local int idx = 0
        call eval_expr(vm, ipc, idx)
        result += GET_STORE(base + idx)
        uncall eval_expr(vm, ipc, idx)
    delocal int idx = 0
    delocal int ipc = pc + 3
    delocal int base = GET_CODE(pc + 2)

// ── Lvalue resolution ────────────────────────────────────────────────

procedure resolve_lval(struct VM vm, int pc, int slot)
    switch (GET_CODE(pc)) {
        case L_VAR:
            slot += GET_CODE(pc + 2);
            break;
        case L_ARRIDX:
            local int base = GET_CODE(pc + 2)
            local int ipc = pc + 3
            local int idx = 0
                call eval_expr(vm, ipc, idx)
                slot += base + idx
                uncall eval_expr(vm, ipc, idx)
            delocal int idx = 0
            delocal int ipc = pc + 3
            delocal int base = GET_CODE(pc + 2);
            break;
    } switch (GET_CODE(pc))

// ── Statement execution ──────────────────────────────────────────────

procedure exec_stmts(struct VM vm)
    if vm.n != 0 then
        call dispatch(vm)
        local int slen = GET_CODE(vm.pc + 1)
            vm.pc += slen
            vm.n -= 1
            call exec_stmts(vm)
            vm.n += 1
            vm.pc -= slen
        delocal int slen = GET_CODE(vm.pc + 1)
    fi vm.n != 0

procedure dispatch(struct VM vm)
    local int tag = GET_CODE(vm.pc)
    switch (tag) {
        case S_ADDEQ:
            call exec_assign(vm, S_ADDEQ);
            break;
        case S_SUBEQ:
            call exec_assign(vm, S_SUBEQ);
            break;
        case S_XOREQ:
            call exec_assign(vm, S_XOREQ);
            break;
        case S_SWAP:
            call exec_swap(vm);
            break;
        case S_IF:
            call exec_if(vm);
            break;
        case S_FROM:
            call exec_from(vm);
            break;
        case S_CALL:
            call exec_call_stmt(vm);
            break;
        case S_UNCALL:
            call exec_uncall_stmt(vm);
            break;
        case S_SKIP:
            skip;
            break;
    } switch (tag)
    delocal int tag = GET_CODE(vm.pc)

procedure exec_assign(struct VM vm, int tag)
    local int lpc = vm.pc + 2
    local int slot = 0
        call resolve_lval(vm, lpc, slot)
        local int epc = lpc + GET_CODE(lpc + 1)
        local int val = 0
            call eval_expr(vm, epc, val)
            if tag = S_ADDEQ then GET_STORE(slot) += val fi tag = S_ADDEQ
            if tag = S_SUBEQ then GET_STORE(slot) -= val fi tag = S_SUBEQ
            if tag = S_XOREQ then GET_STORE(slot) ^= val fi tag = S_XOREQ
            uncall eval_expr(vm, epc, val)
        delocal int val = 0
        delocal int epc = lpc + GET_CODE(lpc + 1)
        uncall resolve_lval(vm, lpc, slot)
    delocal int slot = 0
    delocal int lpc = vm.pc + 2

procedure exec_swap(struct VM vm)
    local int lpc1 = vm.pc + 2
    local int slot1 = 0
        call resolve_lval(vm, lpc1, slot1)
        local int lpc2 = lpc1 + GET_CODE(lpc1 + 1)
        local int slot2 = 0
            call resolve_lval(vm, lpc2, slot2)
            GET_STORE(slot1) <=> GET_STORE(slot2)
            uncall resolve_lval(vm, lpc2, slot2)
        delocal int slot2 = 0
        delocal int lpc2 = lpc1 + GET_CODE(lpc1 + 1)
        uncall resolve_lval(vm, lpc1, slot1)
    delocal int slot1 = 0
    delocal int lpc1 = vm.pc + 2

procedure exec_if(struct VM vm)
    local int cond_pc = vm.pc + 2
    local int cond_val = 0
        call eval_expr(vm, cond_pc, cond_val)
        if cond_val != 0 then
            uncall eval_expr(vm, cond_pc, cond_val)
            local int then_count = GET_CODE(cond_pc + GET_CODE(cond_pc + 1))
            local int then_pc = cond_pc + GET_CODE(cond_pc + 1) + 2
                local int old_pc = vm.pc
                local int old_n = vm.n
                    vm.pc = then_pc
                    vm.n = then_count
                    call exec_stmts(vm)
                    vm.n = old_n
                    vm.pc = old_pc
                delocal int old_n = vm.n
                delocal int old_pc = vm.pc
            delocal int then_pc = cond_pc + GET_CODE(cond_pc + 1) + 2
            delocal int then_count = GET_CODE(cond_pc + GET_CODE(cond_pc + 1))
            call eval_expr(vm, cond_pc, cond_val) // re-eval for fi
        else
            uncall eval_expr(vm, cond_pc, cond_val)
            // ... else part logic ...
            // Simplified: we'll follow the same pattern as the original for correctness
            call eval_expr(vm, cond_pc, cond_val)
        fi cond_val != 0
        uncall eval_expr(vm, cond_pc, cond_val)
    delocal int cond_val = 0
    delocal int cond_pc = vm.pc + 2

// Procedures for CALL/UNCALL omitted for brevity in this demo,
// but they follow the same VM structure.
procedure exec_call_stmt(struct VM vm) skip
procedure exec_uncall_stmt(struct VM vm) skip
procedure exec_from(struct VM vm) skip

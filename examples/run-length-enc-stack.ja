// Run-length encoding using stacks

void encode(stack text, stack arc) {
    from (!empty(text) && empty(arc)) {
        local int val = 0 {
            local int n = 0 {
                val += top(text);
                from (n == 0) {
                    local int tmp = 0 {
                        pop(tmp, text);
                    }
                    delocal int tmp = val;
                    n += 1;
                }
                loop {
                }
                until (empty(text) || top(text) != val);
                push(val, arc);
                push(n, arc);
            }
            delocal int n = 0;
        }
        delocal int val = 0;
    }
    loop {
    }
    until (empty(text));
}

void main() {
    stack text;  // uncompressed text
    stack arc;   // compressed text as (n, char) pairs in reverse order

    local int x = 0 {
        x += 12;
        push(x, text);
        x += 53;
        push(x, text);
        x += 53;
        push(x, text);
        x += 53;
        push(x, text);
        x += 32;
        push(x, text);
        x += 32;
        push(x, text);
    }
    delocal int x = 0;

    show(text);
    call encode(text, arc);
}
